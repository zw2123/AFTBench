# AFTBench LLM API keys template.
# Copy this file to `.env` (repo root) and fill in your keys.
# `.env` is gitignored — never commit real keys.
#
# Format: KEY=value  (one per line, no quotes needed)
# Provider profiles in configs/llm/providers.yaml reference these names
# via their `api_key_env` field.

# Qwen (DashScope compatible-mode)
AFTBENCH_API_KEY_QWEN=sk-your-qwen-key

# DeepSeek
AFTBENCH_API_KEY_DEEPSEEK=sk-your-deepseek-key

# GPT-5.6 Sol (OpenAI-compatible)
AFTBENCH_API_KEY_SOL=sk-your-sol-key
