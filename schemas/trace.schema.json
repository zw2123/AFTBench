{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aftbench.dev/schemas/trace.schema.json",
  "title": "AFTBench Trace Event",
  "description": "Schema for individual trace events within an agent run.",
  "type": "object",
  "required": [
    "trace_id",
    "task_id",
    "turn_index",
    "timestamp",
    "event_type",
    "agent_id",
    "interface"
  ],
  "properties": {
    "trace_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique trace run identifier"
    },
    "task_id": {
      "type": "string",
      "description": "Reference to the task being executed"
    },
    "turn_index": {
      "type": "integer",
      "minimum": 0,
      "description": "Zero-based turn index within the trace"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of the event"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "observation",
        "action",
        "tool_call",
        "tool_result",
        "agent_thought",
        "fault_injection",
        "state_snapshot",
        "postcondition_check",
        "budget_exceeded",
        "task_complete",
        "task_failed"
      ],
      "description": "Type of trace event"
    },
    "agent_id": {
      "type": "string",
      "description": "Identifier of the agent producing this event"
    },
    "interface": {
      "type": "string",
      "enum": ["I0", "I1", "I2", "I3", "I4", "I5"],
      "description": "Interface level used for this event"
    },
    "content": {
      "type": "object",
      "description": "Event-specific payload",
      "properties": {
        "observation": {
          "type": "object",
          "properties": {
            "source": { "type": "string" },
            "data": {}
          }
        },
        "action": {
          "type": "object",
          "properties": {
            "capability": { "type": "string" },
            "arguments": { "type": "object" }
          }
        },
        "tool_call": {
          "type": "object",
          "properties": {
            "tool_name": { "type": "string" },
            "parameters": { "type": "object" },
            "call_id": { "type": "string" }
          }
        },
        "tool_result": {
          "type": "object",
          "properties": {
            "call_id": { "type": "string" },
            "success": { "type": "boolean" },
            "result": {},
            "error": { "type": "string" }
          }
        },
        "fault_injection": {
          "type": "object",
          "properties": {
            "fault_type": { "type": "string" },
            "description": { "type": "string" },
            "details": { "type": "object" }
          }
        },
        "postcondition_check": {
          "type": "object",
          "properties": {
            "condition": { "type": "string" },
            "passed": { "type": "boolean" },
            "actual_value": {}
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "seed": { "type": "integer" },
        "world": { "type": "string" },
        "fault_active": { "type": "string" },
        "tokens_used": { "type": "integer" },
        "wall_time_ms": { "type": "integer" }
      }
    }
  },
  "additionalProperties": false
}
